{
  "expo": {
    "name": "FIT AI BUDDY",
    "slug": "fit-ai-buddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fitaibuddy",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0B0D0F",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.romaabi.fitaibuddy"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0D0F"
      },
      "package": "com.romaabi.fitaibuddy"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
